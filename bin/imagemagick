# append {{{
sub imappend {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs   = $opts->{input}        // '';
    my $output   = $opts->{output}       // '';
    my $vertical = $opts->{vertical}     // '';
    # }}}

    my @input = split(",", $inputs);

    my $append;
    $append = "+append" if $vertical;
    $append = "-append" unless $vertical;

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "$input[0] > $output ");
    my @exe = (
        $runner,
        $append,
        $input[0],
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# blur {{{
sub imblur {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my $blur   = $opts->{blur}         // 3;
    my $rate   = $opts->{rate}         // 5;
    my $scale  = $opts->{scale}        // 3;
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "$input[0] > $output ");
    my $format = "\%[fx:w+((w+h)/${scale}*0.1)]x\%[fx:h+((w+h)/${scale}*0.1)]";
    my $geo = `$identify -format "$format" "@{input}"`;

    my @exe = (
        $runner,
        "-resize", "$blur\%",
        $input[0],
        "-gaussian-blur", "1x${rate}",
        "-resize", "${geo}^",
        "-extent", "${geo}",
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# crop {{{
sub imcrop {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my $round  = $opts->{round}        // 25;
    my $shape  = $opts->{shape}        // 'square';
    # }}}

    my @input = split(",", $inputs);
    my $sqrp = $round;

    my $x = `$identify -format '\%w' $input[0]`;
    my $y = `$identify -format '\%h' $input[0]`;
    my $xmid = $x // 2;
    my $ymid = $y // 2;

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "$input[0] > $output ");
    my @exe;
    if ($shape eq "circle") {
        @exe = (
            $runner,
            $input[0],
            "\(",
                "+clone",
                "-size", "${x}x${y}",
                "-threshold", "100\%",
                "-fill", "white",
                "-draw", "roundrectangle 0,0 ${x},${y} ${xmid},${ymid}",
            "\)",
            "-alpha", "off",
            "-compose", "CopyOpacity",
            "-composite",
            $output,
        );
    } else {
        @exe = (
            $runner,
            $input[0],
            "\(",
                "+clone",
                "-threshold", "100\%",
                "-fill", "white",
                "-draw", "roundrectangle 0,0 ${x},${y} ${sqrp},${sqrp}",
            "\)",
            "-alpha", "off",
            "-compose", "CopyOpacity",
            "-composite",
            $output,
        );
    }

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# color {{{
sub imcolor {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output  = $opts->{output}       // '';
    my $find    = $opts->{find}         // '';
    my $replace = $opts->{replace}      // '';
    my $percent = $opts->{percent}      // 55;
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;
    logger($subname, "No color is specified to find\n", 3) unless $find;
    logger($subname, "No color is specified to replace\n", 3) unless $replace;

    pretty("$subname", "$input[0] > $output ");
    my @exe = (
        $runner,
        $input[0],
        "-fuzz",   "$percent\%",
        "-fill",   "$find\%",
        "-opaque", "$replace\%",
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# merge {{{
sub immerge {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my $fade   = $opts->{fade}         // '';
    my @fader = ("-blend", "$fade") if $fade;
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "@input > $output ");
    my @exe = (
        $composite,
            @input,
            "-channel", "RGBA",
            @fader,
            "-gravity", "Center",
            "-alpha", "set",
            ${output}
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# gradiant {{{
sub imgradiant {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my %color = (
        first       => $opts->{color_first}       // '#770000',
        second      => $opts->{color_second}      // '#ff7700',
        background  => $opts->{color_background}  // 'none',
    );
    my %shadow = (
        apply  => $opts->{shadow_apply}  // '',
        color  => $opts->{shadow_color}  // 'black',
        width  => $opts->{shadow_width}  // 110,
        rate   => $opts->{shadow_rate}   // 10,
    );
    my %border = (
        color  => $opts->{border_color}  // 'none',
        width  => $opts->{border_width}  // 0,
        rate   => $opts->{border_rate}   // 90,
    );
    my %position = (
        x  => $opts->{position_x}  // 1,
        y  => $opts->{position_y}  // 1,
    );
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    my $tmpdir = "/tmp/imagemagick-$timestamp";
    my $tmpfile = "$tmpdir/imagemagick-tmp-gradiant.png";
    mkdir($tmpdir);

    my $resolution   = `$identify -format '%wx%h' $input[0]`;
    my $resolution_x = `$identify -format '%w' $input[0]` + $border{rate};
    my $resolution_y = `$identify -format '%h' $input[0]` + $border{rate};

    # print(STREAM "resolution: $resolution\n");
    # print(STREAM "resolution_x: $resolution_x\n");
    # print(STREAM "resolution_y: $resolution_y\n");
    # foreach my $ent (@input) {
    #     print("input: $ent\n");
    # }
    # exit 0;

    pretty("$subname", "$input[0] > $output ");
    my @exe = (
        $runner,
        "-size", "${resolution_x}x${resolution_y}",
        "gradient:$color{first}-$color{second}",
        "xc:",
        "-bordercolor", $border{color},
        "-border", $border{width},
        "+swap",
        "-background", $color{background},
        "-layers", "merge",
        "+repage",
        $tmpfile,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));

    imcrop({input => $input[0], output => $output, shadow_rate => 45, shadow_width => 80});
    imshadow({input => $output, output => $output, shape => "square"});
    imshadow({input => $output, output => $output, shadow_rate => 45, shadow_width => 80}) if defined $shadow{apply};
    immerge({input => "${output},$tmpfile", output => $output});

    pretty($subname, "remove $tmpdir ");
    remove_tree($tmpdir, {error => \my $err});
    if (@$err) {
        foreach my $diag (@$err) {
            print(STREAM check_exit_code($?));
            logger($subname, "Failed to remove $diag->[0]: $diag->[1]\n", 2);
        }
    } else {
        # pretty("$subname", "remove $tmpdir");
        print(STREAM check_exit_code($?));
        
    }
}
# }}}

