# functions

# helper {{{

# usage {{{
sub print_usage {
print <<"EOF";
Image minapulation script -- ImageMagick wrapper

usage: $prompt COMMAND OPTIONS

   • COMMANDS
       shadow        add shadow effects
       trim          trim borders

   • OPTIONS
       -i --input    input file
       -o --output   output file
       -h --help     print this message

   • example:
       $prompt shadow -i input.png -o output.png

EOF
exit 0;
}
# }}}

# command {{{
sub command {
    my $program = $_[0];
    my $path = $ENV{"PATH"};
    my @directories = split(":", $path);
    my $found = '';
    foreach my $dir (@directories) {
        my $full_path = "$dir/$program";
        if (-x $full_path) {
            $found = $full_path;
            last;
        }
    }
    return $found;
}

my $runner;
my $composite;
my $highligher;
my $import;
my $identify;
my $found_im;

if (command("magick")) {
    $found_im = 0;
    $runner = command("magick");
} else {
    $found_im = 1;
}

if (command("convert")) {
    $found_im = 0;
    $runner = command("convert");
    $composite = command("composite");
    $import = command("import");
    $highligher = command("pygmentize");
    $identify = command("identify");
} else {
    $found_im = 1;
}

if ($found_im) {
    print(STREAM "ImageMagick is not installed\n");
    exit 1;
}
# }}}

# exit code {{{
sub check_exit_code {
    my ($package, $filename, $line) = caller();
    my $exit_code = $_[0];
    my $fail = 'fail';  # ×
    my $done = 'done';  # ✓
    my $side = "fg";
    $fail = "$fail" if $side eq "fg";
    $done = "$done" if $side eq "fg";
    $fail = " $fail " if $side eq "bg";
    $done = " $done " if $side eq "bg";
    my %color = (
        bg => {
            fail => "on_red",
            done => "on_green",
        },
        fg => {
            fail => "bold red",
            done => "bold green",
        },
    );
    my $msg = "";
    if ($exit_code) {
        $msg = color($color{$side}{fail}).$fail.color("reset");
        print("\n");
        exit $line;
    } else {
        $msg = color($color{$side}{done}).$done.color("reset");
        # exit 0;
    }
    return $msg;
}
# }}}

# logger {{{
sub logger {
    my ($name, $msg, $level) = @_;
    $name =~ s,^im,,;
    $level //= 1;
    my ($package, $filename, $line) = caller();
    my $current_date = strftime("%Y-%m-%d %H:%M:%S", localtime);

    my $message = "] $current_date ${prompt} ${package}::${name}::${line} | $msg";

    return if $level == 0;
    print($message) if $level == 1;
    print(STREAM "\r") if $level != 1;
    print(STREAM $message) if $level != 1;
    print(STREAM "\n") if $level gt 3;
    exit $line if $level ge 3;
}
# }}}

# prettry {{{
sub pretty {
    my ($name, $msg, $level) = @_;
    $name =~ s,^im,,;
    $level //= 5;
    my ($package, $filename, $line) = caller();

    # left padding
    my $current_length = $length - length($name) + 1;
    my $blank = " "x$current_length;

    my $logcolor;
    $logcolor = "black" if $level == 0;
    $logcolor = "red" if $level == 1;
    $logcolor = "green" if $level == 2;
    $logcolor = "yellow" if $level == 3;
    $logcolor = "blue" if $level == 4;
    $logcolor = "magenta" if $level == 5;
    $logcolor = "cyan" if $level == 6;
    $logcolor = "white" if $level == 7;

    my $message = "";

    # $message = "$prompt ".color("bold $logcolor")."${package}::$name".color('reset')." $msg";
    # $message = "$prompt ".color("bold $logcolor")."$name".color('reset').$blank.$msg;

    $message = "$prompt ".color("bold $logcolor")."$name".color('reset').$blank;

    print(STREAM "\r$message");

    # print(STREAM "\033[K");  # clear the line
    # print(STREAM "\r");
    # print(STREAM "\033[F");  # move up
    # print(STREAM "\033[2J");  # clear the screen
    # print(STREAM "\033[H");   # move cursor to the top left
}
# }}}

# }}}

# workers {{{

# shadow {{{
sub imshadow {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my %border = (
        color => $opts->{border_color} // "none",
        width => $opts->{border_width} // 0,
    );
    my %shadow = (
        width => $opts->{shadow_width} // 110,
        color => $opts->{shadow_color} // "black",
        rate  => $opts->{shadow_rate}  // 10,
        x     => $opts->{shadow_x}     // 1,
        y     => $opts->{shadow_y}     // 1,
    );
    my $background_color = $opts->{background_color} // "none";
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "$input[0] > $output ");
    my @exe = (
        $runner,
        $input[0],
        "-bordercolor", $border{color},
        "-border", $border{width},
        '(',
            "+clone",
            "-background", ${background_color},
            "-shadow", "$shadow{width}x$shadow{rate}+$shadow{x}+$shadow{y}",
        ')',
        "+swap",
        "-background", "${background_color}",
        "-layers", "merge", "+repage",
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# alpha {{{
sub imalpha {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my $color  = $opts->{color}       // 'white';
    my $fuzz   = $opts->{fuzz}       // 99;
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "$input[0] > $output ");
    my @exe = (
        $runner,
        "-transparent", $color,
        "-fuzz", "$fuzz\%",
        $input[0],
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

