    job::merge({
        input => join(",", @input),
        output => $output,
    });
    exit 0;
}

if ($cmd eq "trim") {
    job::trim({
        input => join(",", @input),
        output => $output,
    });
    exit 0;
}

if ($cmd eq "string") {
    @input = ('null') unless @input;
    job::string({
        input => @input,
        output => $output,
        width => $width,
        height => $height,
        text => \@text,
        font => $font,
        alpha => $alpha,
        scale => $scale,
        color_background => $background,
        color_foreground => $foreground,
        size => $size,
    });
    exit 0;
}

