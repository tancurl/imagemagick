    # title {{{
    sub title {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs   = $opts->{input}    // '';
        my $output   = $opts->{output}   // '';
    	my $window   = $opts->{window}   // 1;;
    	my $title    = $opts->{title}    // 'Source Code';;
        my $font     = $opts->{font}     // $default{font}{sans};;
        my $vertical = $opts->{vertical} // '-0';;
        my $size     = $opts->{size}     // $default{font}{size};;
        my %color = (
            background => $opts->{color_background} // $default{color}{background},
            foreground => $opts->{color_foreground} // $default{color}{foreground},
            temperory  => $opts->{color_temperory}  // $default{color}{temperory},
            button => {
                close => $opts->{color_button_close} // '#ff5f56', # '#9999A0',
                maxim => $opts->{color_button_maxim} // '#5fc451', # '#9999A0',
                minim => $opts->{color_button_minim} // '#ffbd2e', # '#9999A0',
            },
        );
        my %border = (
            rate => 20,
        );
        # }}}

        my @input = split(",", $inputs);

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        my $tmpdir = "/tmp/imagemagick/$timestamp-$subname";
        my $tmpfile_title_bar = "$tmpdir/imagemagick-tmp-title-bar.png";
        my $tmpfile_title_button = "$tmpdir/imagemagick-tmp-title-button.png";
        make_path($tmpdir);

        my %resolution = (
            a => `$identify -format '%wx%h' $input[0]`,
            x => `$identify -format '%w' $input[0]`,
            y => `$identify -format '%h' $input[0]`,
        );
        my %resolution_out = (
            x => $resolution{x} + $border{rate},
            y => $resolution{y} + $border{rate},
        );

        my $width = $resolution{x};
        my $height = $border{rate} + $border{rate};

        my $_tmpfile_title_button = (split("/", $tmpfile_title_button))[-1];
        my $_tmpfile_title_bar    = (split("/", $tmpfile_title_bar))[-1];

        mob::pretty($subname, "template base image for frame title");
        my @exe = (
            $runner,
            "-size", "${width}x$height",
            "gradient:$color{temperory}-$color{background}",
            "-font", $font,
            "-pointsize", $size,
            "-fill", $color{foreground},
            "-gravity", "center",
            "-annotate", "+000$vertical", $title,
            $tmpfile_title_bar,
        );
        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";

        mob::pretty($subname, "create frame bar");
        @exe = (
            $runner,
                $tmpfile_title_bar,
                "-fill", $color{button}{close}, "-draw", "circle 20,19 27,19",
                "-fill", $color{button}{minim}, "-draw", "circle 44,19 51,19",
                "-fill", $color{button}{maxim}, "-draw", "circle 68,19 75,19",
                $tmpfile_title_button,
        );
        $_exit_code = mob::shell(@exe);
        $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";

        mob::log($subname, "missing file: $tmpfile_title_button\n", 3) unless -f $tmpfile_title_button;
        mob::log($subname, "missing file: $tmpfile_title_bar\n", 3) unless -f $tmpfile_title_bar;

        job::append({input => "$tmpfile_title_button,$input[0]", output => $output, vertical => 1});
        mob::clean();

        mob::pretty($subname, "remove $tmpdir");
        remove_tree($tmpdir, {error => \my $err});
        if (@$err) {
            foreach my $diag (@$err) {
                print(STREAM mob::check_exit_code($?));
                print "\n";
                mob::log($subname, "Failed to remove $diag->[0]: $diag->[1]\n", 2);
            }
        } else {
            mob::pretty($subname, "remove $tmpdir");
            print(STREAM mob::check_exit_code($?));
            print "\n";
        }

        mob::pretty($subname, "add window-frame like title");
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # extend {{{
    sub extend {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs   = $opts->{input}        // '';
        my $output   = $opts->{output}       // '';
        my $mirror   = $opts->{mirror}       // 0;
        my $gradient = $opts->{gradient}     // 0;
        my %color  = (
            background => $opts->{color_background} // $default{color}{background},
            temperory  => $opts->{color_temperory}  // $default{color}{temperory},
            border     => $opts->{color_border}     // $default{color}{border},
        );
        my $rate   = $opts->{rate}  // 2;
        my %shadow = (
            width => $opts->{shadow_width} // 0,
            color => $opts->{shadow_color} // "black",
            rate  => $opts->{shadow_rate}  // 0,
        );
        my %offset = (
            x     => 0,
            y     => 0,
        );
        my $background_color = $opts->{background_color} // $default{color}{background};
        # }}}

        my @input = split(",", $inputs);

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        # mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        my $x = `$identify -format '\%w' $input[0]`;
        my $y = `$identify -format '\%h' $input[0]`;
        my $W = $x + $rate;
        my $H = $y + $rate;

        ($color{background}, $color{temperory}) = ($color{temperory}, $color{background}) if $mirror;

        mob::pretty($subname, "extend image by color");
        my @exe;
        unless ($gradient) {
            $color{temperory} = $color{background};
        }
        @exe = (
            $runner,
            '(',
                '-size', "${W}x${H}",
                "gradient:$color{background}-$color{temperory}",
            ')',
            '(',
                $input[0],
                '(',
                    '+clone',
                    '-background', $shadow{color},
                    '-shadow', "$shadow{width}x$shadow{rate}+$offset{x}+$offset{y}",
                ')',
                '+swap',
                '-background', 'none',
                '-layers', 'merge',
            ')',
            '-gravity', 'center',
            '-compose', 'over',
            '-composite',
            $output,
        );
        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # src {{{
    sub src {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs     = $opts->{input}      // '';
        my $output     = $opts->{output}     // '';
        my $language   = $opts->{language}   // '';
        my $linenumber = $opts->{linenumber} // 0;
        my $theme      = $opts->{theme}      // 'gruvbox-dark';
        my %font = (
            name => $opts->{font_name} // $default{font}{mono},
            size => $opts->{font_size} // $default{font}{size},
        );
        my %frame = (
            title => $opts->{frame_title} // 'Source Code',
        );
        my $round  = $opts->{round}          // 5;
        my %shadow = (
            apply  => $opts->{shadow_apply}  // 0,
            color  => $opts->{shadow_color}  // 'black',
            width  => $opts->{shadow_width}  // 110,
            rate   => $opts->{shadow_rate}   // 10,
        );
        my %color = (
            border     => $opts->{color_border}     // $default{color}{border},
            frame      => $opts->{color_frame}      // $default{color}{frame},
            background => $opts->{color_background} // $default{color}{background},
            foreground => $opts->{color_foreground} // $default{color}{foreground},
            gradient   => {
                first  => $opts->{color_gradient_first}  // '#9F8F6D',
                second => $opts->{color_gradient_second} // '#6F8B88',
            },
        );
        my %alpha = (
            apply       => $opts->{alpha_apply} // 1,
            width       => $opts->{alpha_width} // 20,
        );
        my %border = (
            width       => $opts->{border_width} // 25,
        );
        my %gradient = (
            apply  => $opts->{gradient_apply}    // 1,
            mirror => $opts->{gradient_mirror}   // 0,
            rotate => $opts->{gradient_rotate}   // 0,
            width  => $opts->{gradient_width}    // 100,
            height => $opts->{gradient_height}   // 160,
            orientation => $opts->{gradient_orientation} // "vertical",
        );
        # }}}

        my @input = split(",", $inputs);

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        my $tmpdir = "/tmp/imagemagick/$timestamp-$subname";
        my $tmpfile_nl = "$tmpdir/imagemagick-tmp-nl.txt";
        my $tmpfile_pango = "$tmpdir/imagemagick-tmp-pango.xml";
        my $tmpfile_image = "$tmpdir/imagemagick-tmp-image.png";
        make_path($tmpdir);

        # add line numbering to the src image
        if ($linenumber) {
            my @job_add_line_number = (
                "nl", "-b", "a", $input[0]
            );
            open my $output_fh, '>', $tmpfile_nl or die "Could not open '$tmpfile_nl': $!";
            open my $nl_fh, '-|', @job_add_line_number or die "Could not execute nl: $!";
            while (my $line = <$nl_fh>) {
                print $output_fh $line;
            }
            close $nl_fh;
            close $output_fh;
        } else {
            $tmpfile_nl = $input[0];
        }

        # get the language for syntax highlighting
        $language = mob::get_syntax($input[0]) unless $language;

        # generate pango
        mob::pretty($subname, "generate src pango");
        my @exe = (
            $highlighter,
                $tmpfile_nl,
                "-O", "style=$theme",
                "-O", "bgcolor=base03",
                "-f", "pango",
                "-o", $tmpfile_pango
        );
        push(@exe, ("-l", $language)) if $language;
        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        mob::check_exit_code($exit_code);
        print "\n";

        # generate image
        mob::pretty($subname, "generate src frame");
        @exe = (
            $runner,
            "-background", $color{background},
            "-pointsize", $font{size},
            "pango:\@$tmpfile_pango",
            $tmpfile_image,
        );
        $_exit_code = mob::shell(@exe);
        $exit_code = $_exit_code >> 8;
        mob::check_exit_code($exit_code);
        print "\n";

        # extra filters and visual effects
        job::trim({input => $tmpfile_image, output => $output}); mob::clean();
        job::shadow({
            input => $output,
            output => $output,
            shadow_width => 0,
            shadow_rate  => 0,
            border_width => $border{width},
            border_color => '#151515',
            background_color => 'none',
        }); mob::clean();
        job::trim({input => $output, output => $output});
            mob::clean();
        job::title({input => $output, output => $output, frame_title => $frame{title}, background_color => $color{background}});
            mob::clean();
        job::round({input => $output, output => $output, round => $round});
            mob::clean();
        job::extend({input => $output, output => $output, rate => 2});
            mob::clean();
        job::round({input => $output, output => $output, round => $round});
            mob::clean();
        job::extend({input => $output, output => $output, rate => 2, mirror => 1});
            mob::clean();
        job::round({input => $output, output => $output, round => $round});
            mob::clean();
        job::extend({input => $output, output => $output, rate => 2});
            mob::clean();
        job::round({input => $output, output => $output, round => $round});
            mob::clean();
        # job::extend({input => $output, output => $output, rate => 1, mirror => 1});
        #   mob::clean();
        # job::round({input => $output, output => $output, round => $round});
        #   mob::clean();
        if ($alpha{apply}) {
            job::extend({input => $output, output => $output, rate => $alpha{width}, gradient => 0, color_background => 'none'});
                mob::clean();
        }
        if ($shadow{apply}) {
            job::shadow({
                input => $output,
                output => $output,
                shadow_width => $shadow{width},
                shadow_rate  => $shadow{rate},
                shadow_color => $shadow{color},
                border_width => 10,
            });
            mob::clean();
        }
        if ($shadow{apply}) {
            job::shadow({
                input => $output,
                output => $output,
                shadow_width => $shadow{width},
                shadow_rate  => $shadow{rate} * 10,
                shadow_color => $shadow{color},
                border_width => 10,
            });
            mob::clean();
        }
        if ($gradient{apply}) {
            job::gradient({
                input => $output,
                output => $output,
                color_first => $color{gradient}{first},
                color_second => $color{gradient}{second},
                gradient_width => "",
                gradient_height => "",
                mirror => $gradient{mirror},
                rotate => $gradient{rotate},
                orientation => $gradient{orientation},
            });
            mob::clean();
        }

        # clean up the mess
        mob::pretty($subname, "remove $tmpdir");
        remove_tree($tmpdir, {error => \my $err});
        if (@$err) {
            foreach my $diag (@$err) {
                print(STREAM mob::check_exit_code($?));
                print "\n";
                mob::log($subname, "Failed to remove $diag->[0]: $diag->[1]\n", 2);
            }
        } else {
            mob::pretty($subname, "remove $tmpdir");
            print(STREAM mob::check_exit_code($?));
            print "\n";
        }

        # frag out!
        mob::pretty($subname, "src shot window");
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # palette {{{
    sub palette {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs = $opts->{input}   // '';
        my $number = $opts->{number}  // 16;
        my $space  = $opts->{space}   // 'LAB';
        my $type   = $opts->{type}    // 'hex';
        my $alpha  = $opts->{alpha}   // 1;
        # }}}

        my @input = split(",", $inputs);

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];

        mob::pretty($subname, "generate palette");
        my @exe = (
            $runner,
            $input[0],
            "-format", '%c',
            "-colorspace", $space,
            "-colors", $number,
            "histogram:info:-",
        );

        my $tmp_output = `@exe`;
        my $exit_code = $? >> 8;
        chomp($tmp_output) if $tmp_output;

        my @palette;
        my @_output = split("\n", $tmp_output);
        foreach my $line (@_output) {
            my $color;
            my ($id, $kernel, $hex, $rgb) = split(" ", $line);
            if ($alpha) {
                # no alpha channel
                $hex =~ s/(.{6})..$/$1/;
                $rgb =~ s/(.*)\((.*),(.*),(.*),(.*)\)$/$1($2,$3,$4)/;

                # # also return the alpha channel
                # $hex =~ s/(.{7})(.{2})$/hex:$1 alpha:$2/;
                # $rgb =~ s/(.*)\((.*),(.*),(.*),(.*)\)$/$1($2,$3,$4) a($5)/;
            }
            $color = $hex if $type eq 'hex';
            $color = $rgb if $type eq 'rgb';
            $color = "$hex $rgb" if $type eq 'all';
            push(@palette, $color) if $color;
        }

        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
        return @palette;
    }
    # }}}

    # string {{{
    sub string {
        my $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs = $opts->{input}   // 'null';
        my $output = $opts->{output}  // '';
        my $scale  = $opts->{scale}   // 1;
        my $alpha  = $opts->{alpha}   // 0;
        my $text   = join("\n", @{ $opts->{text} // [] });
        my $width  = $opts->{width}   // 800;
        my $height = $opts->{height}  // 600;
        my $ltr    = $opts->{ltr}     // 'caption';  # pango
        my %font = (
            name => $opts->{font}     // $default{font}{sans},
            size => $opts->{size}     // 0,
        );
        my %gap = (
            i => $opts->{gap_i}    // 0,
            x => $opts->{gap_x}    // 0,
            y => $opts->{gap_y}    // 0,
        );
        my %color  = (
            foreground => $opts->{color_foreground}  // 'black',
            background => $opts->{color_background}  // 'white',
        );
        # }}}

        mob::log($subname, "text is not specified\n", 3) unless $text;
        mob::log($subname, "output image is not specified\n", 3) unless $output;

        my @input;

        my $merge = 0;
        my $generate = 0;

        if ($inputs && $inputs ne 'null') {
            @input = split(",", $inputs);
            $merge = 1;
        } else {
            mob::log($subname, "input is not specified\n", 2);
            $generate = 1;
        }

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);
        my $tmpdir = "/tmp/imagemagick/$timestamp-$subname";
        my $tmpfile_text = "$tmpdir/imagemagick-tmp-text.png";
        my $tmpfile_image = "$tmpdir/imagemagick-tmp-image.png";

        if ($merge) {
            make_path($tmpdir);
            $generate = 0;
        }
        if ($generate) {
            mob::log($subname, "missing input file, an empty image will be generated\n", 2);
            $tmpfile_text = $output;
            $input[0] = $output;
            $merge = 0;
        }

        # print("width: $width\n");
        # print("height: $height\n");
        if ($merge) {
            my %resolution = (
                a => `$identify -format '%wx%h' $input[0]`,
                x => `$identify -format '%w' $input[0]`,
                y => `$identify -format '%h' $input[0]`,
            );
            $width = $resolution{x} / $scale;
            $height = $resolution{y} / $scale;
        }
        # print("width: $width\n");
        # print("height: $height\n");
        # # exit 0;

        my $resolution = "${width}x$height";
        my $inner_gap;
        my $inner_width;
        my $inner_height;
        my $inner_resolution = $resolution;
        if ($gap{i}) {
            $inner_gap        = $gap{i} * 100;
            $inner_width      = $width - $inner_gap;
            $inner_height     = $height - $inner_gap;
            $inner_resolution = "${inner_width}x$inner_height";
        }

        if ($merge) {
            $color{background} = 'none';
        }
        my @exe = (
            $runner,
                "-gravity", "West",
                "-background", $color{background},
                "-fill", $color{foreground},
                "-size", $inner_resolution,
                "-font", $font{name},
        );
        push @exe, "-transparent", $color{background} if $alpha;
        push(@exe, ("-pointsize", $font{size})) if $font{size};
        push(@exe, (
            "${ltr}:$text",
            "-background", $color{background},
            "-gravity", "Center",
            "-extent", $resolution,
            $tmpfile_text
        ));
        mob::pretty($subname, "string to image");
        my $_exit_code = mob::shell(@exe);
        print(STREAM mob::check_exit_code($_exit_code));
        print "\n";

        if ($merge) {
            # job::trim({input => $tmpfile_text, output => $tmpfile_text});
            # mob::clean();

            job::resize({input => $tmpfile_text, output => $tmpfile_text, resolution_a => $resolution});
            mob::clean();

            job::merge({input => "$tmpfile_text,$input[0]", output => $output});
            mob::clean();
        }

        mob::pretty($subname, "remove $tmpdir");
        # print(STREAM mob::check_exit_code(0));
        # print "\n";
        remove_tree($tmpdir, {error => \my $err});
        if (@$err) {
            foreach my $diag (@$err) {
                print(STREAM mob::check_exit_code(1));
                print "\n";
                mob::log($subname, "Failed to remove $diag->[0]: $diag->[1]\n", 2);
            }
        } else {
            print(STREAM mob::check_exit_code(0));
            print "\n";
        }

        mob::pretty($subname, "generate picture");
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # box {{{
    sub box {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs      = $opts->{input}       // '';
        my $output      = $opts->{output}      // '';
        my $color       = $opts->{color}       // '';
        my $mirror      = $opts->{mirror}      // 0;
        my $rotate      = $opts->{rotate}      // 0;
        my $expand      = $opts->{expand}      // 0;
        # }}}

        my @input  = split(",", $inputs);
        my @colors = split(",", $color);
        my $count  = scalar @colors;

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        my $fix;
        my $x = `$identify -format "%w" "@{input}"`;
        my $y = `$identify -format "%h" "@{input}"`;

        $x = $x + $expand if $expand;
        $y = $y + $expand if $expand;

        if ($x <= $y) {
            $fix = $y;
        } else {
            $fix = $x;
        }

        if ($count) {
            if ($count gt 1) {
                job::gradient({
                    input => $input[0],  # <1> loop over it if it's possible
                    output => $output,
                    color_first => $color[0],
                    color_second => $color[1],
                    gradient_width => "",
                    gradient_height => "",
                    border_rate => 0,
                    x => $fix,
                    y => $fix,
                    rotate => $rotate,
                    mirror => $mirror,
                });
            } else {
                my $tmpdir = "/tmp/imagemagick/$timestamp-$subname";
                my $tmpfile = "$tmpdir/imagemagick-tmp-box.png";
                make_path($tmpdir);
                job::solid({
                    width => $fix,
                    height => $fix,
                    background => $color[0],
                    output => $tmpfile,
                });
                job::merge({
                    input => sprintf("%s,%s", $input[0], $tmpfile),
                    output => $output,
                });
                remove_tree($tmpdir);
            }
        } else {
            job::blur({
                input => join(",", @input),
                output => $output,
                geo => sprintf("%sx%s", $fix, $fix),
                blur => $blur,
                rate => $rate,
                scale => $scale,
            });
            job::merge({
                input => sprintf("%s,%s", $input[0], $output),
                output => $output,
            });
        }

        mob::pretty($subname, "1:1 boxed image");
        print(STREAM mob::check_exit_code(0));
        print "\n";

    }
    # }}}

}
# }}}

if ($help || !$cmd || $cmd eq "help") {
    mob::usage();
    exit 0;
}

