#!/usr/bin/env perl

# preambles {{{
use warnings;
use strict;
use Getopt::Long;
use File::Basename;
use File::Path qw(remove_tree);
use File::Path qw(make_path);
use Cwd;
use IO::Handle;
use POSIX qw(strftime);
use Term::ANSIColor;
use Symbol;
use POSIX qw(_exit);
$| = 1;  # autoflush
# }}}

# debug logs
my $log_level = 1;

# push everything into one stream
my $std_stream = 2;
my $STREAM;
*STREAM = *STDERR if $std_stream == 2;
*STREAM = *STDOUT if $std_stream == 1;

# get list of subroutines {{{
my $filename = $0; # Replace with your script name
open my $fh, '<', $filename or die "Cannot open $filename: $!";
my @lines = <$fh>;
close $fh;
# Create a hash to store subroutine names
my %subroutines;
# Iterate through each line to find subroutine definitions
foreach my $line (@lines) {
    if ($line =~ /^\s*sub\s+(\w+)/) {
        # $subroutines{$1} = 1;  # Store the subroutine name
        if ($line =~ /^\s*sub\s+(im\w+)/) {
            $subroutines{$1} = 1;  # Store the subroutine name
        }
    }
}
# Print the list of subroutines
my @subs = ();
for (keys %subroutines) {
    my $_sub = $_;
    $_sub =~ s/^im//;
    push(@subs, $_sub);
}
# foreach my $ss (@subs) {
#     print("$ss\n");
# }
# }}}

# variables {{{
my @input;
my $output;
my $help = 0;
my $prompt = basename($0);
# }}}

# flags {{{
GetOptions(
    "i|input=s@"   => \@input,
    "o|output=s"   => \$output,
    'h|help'       => \$help,
) or die "Invalid flags. Use -h for help\n";
# }}}

# command {{
my $cmd = shift @ARGV;
# }}}

# calculate blank space {{{
my $length = 0;
foreach my $func (@subs) {
    my $tl = length($func);
    if ($tl gt $length) {
        $length = $tl;
    }
}
# }}}

