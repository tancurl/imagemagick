# command {{{
sub command {
    my $program = $_[0];
    my $path = $ENV{"PATH"};
    my @directories = split(":", $path);
    my $found = '';
    foreach my $dir (@directories) {
        my $full_path = "$dir/$program";
        if (-x $full_path) {
            $found = $full_path;
            last;
        }
    }
    return $found;
}

my $runner;
my $composite;
my $highlighter;
my $import;
my $identify;
my $found_im;

if (command("magick")) {
    $found_im = 0;
    $runner = command("magick");
} else {
    $found_im = 1;
}

if (command("convert")) {
    $found_im = 0;
    $runner = command("convert");
    $composite = command("composite");
    $import = command("import");
    $highlighter = command("pygmentize");
    $identify = command("identify");
} else {
    $found_im = 1;
}

if ($found_im) {
    print(STREAM "ImageMagick is not installed\n");
    exit 1;
}
# }}}

# clean {{{
sub clean {
    # my $clean = "\b\b\b\b    ";
    # print(STREAM $clean);

    my $repeat = 1;
    my @spinner = ('|', '/', '-', '\\');
    my $duration = shift;  # Duration to display the spinner
    my $end_time = time() + $repeat;

    while (time() < $end_time) {
        for my $char (@spinner) {
            print STREAM "\r";
            print STREAM $char;
            sleep(0.06);
            print STREAM "\b ";
        }
    }
}
# }}}

# exit code {{{
sub check_exit_code {
    my ($package, $filename, $line) = caller();
    my $exit_code = $_[0];
    my $fail = 'fail';  # ×
    my $done = "done";  # ✓
    my $side = "fg";
    $fail = "$fail" if $side eq "fg";
    $done = "$done" if $side eq "fg";
    $fail = " $fail " if $side eq "bg";
    $done = " $done " if $side eq "bg";
    my %color = (
        bg => {
            fail => "on_red",
            done => "on_green",
        },
        fg => {
            fail => "bold red",
            done => "bold green",
        },
    );
    my $msg = "";
    if ($exit_code) {
        $msg = color($color{$side}{fail}).$fail.color("reset");
        print("\n");
        exit $line;
    } else {
        $msg = color($color{$side}{done}).$done.color("reset");
    }
    return $msg;
}
# }}}

# logger {{{
sub logger {
    my ($name, $msg, $level) = @_;
    $name =~ s,^im,,;
    $level //= 1;
    my ($package, $filename, $line) = caller();
    my $current_date = strftime("%Y-%m-%d %H:%M:%S", localtime);

    my $message = "] $current_date ${prompt} ${package}::${name}   >>> ${line} | $msg";

    return if $level == 0;
    print($message) if $level == 1;
    print(STREAM "\r") if $level != 1;
    print(STREAM $message) if $level != 1;
    print(STREAM "\n") if $level gt 3;
    exit $line if $level ge 3;
}
# }}}

# prettry {{{
sub pretty {
    my ($name, $msg, $level) = @_;
    $name =~ s,^im,,;
    $level //= 5;
    my ($package, $filename, $line) = caller();

    # left padding
    my $current_length = $blank_height - length($name) + 1;
    my $blank = " "x$current_length;

    my $logcolor;
    $logcolor = "black" if $level == 0;
    $logcolor = "red" if $level == 1;
    $logcolor = "green" if $level == 2;
    $logcolor = "yellow" if $level == 3;
    $logcolor = "blue" if $level == 4;
    $logcolor = "magenta" if $level == 5;
    $logcolor = "cyan" if $level == 6;
    $logcolor = "white" if $level == 7;

    my $message = "";

    # $message = "$prompt ".color("bold $logcolor")."${package}::$name".color('reset')." $msg";
    # $message = "$prompt ".color("bold $logcolor")."$name".color('reset').$blank.$msg;

    $message = "$prompt ".color("bold $logcolor")."$name".color('reset').$blank;

    print(STREAM "\r  $message ");

    # print(STREAM "\033[K");  # clear the line
    # print(STREAM "\r");
    # print(STREAM "\033[F");  # move up
    # print(STREAM "\033[2J");  # clear the screen
    # print(STREAM "\033[H");   # move cursor to the top left
}
# }}}

# get the language {{{
sub get_syntax {
    my $filename = $_[0];  # Replace with your file name
    my $shebang;
    open(my $fh, '<', $filename) or die "Could not open file '$filename' $!";
    my $first_line = <$fh>;
    $shebang = $first_line if $first_line =~ /^#!/;
    chomp($shebang) if $shebang;
    close($fh);
    my $language;
    if ($shebang) {
        $language = (split("/", $shebang))[-1];
        $language =~ s/env // if $language =~ /env /;
        # print(STREAM "$shebang\n");
    } else {
        $language = `$highlighter -N $filename`;
        chomp($language);
    }
    return $language;
}
# }}}

