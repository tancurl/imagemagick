    # round {{{
    sub round {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs = $opts->{input}        // '';
        my $output = $opts->{output}       // '';
        my $round  = $opts->{round}        // 25;
        my %color = (
            background => $opts->{color_background} // $default{color}{background},
            foreground => $opts->{color_foreground} // $default{color}{foreground},
        );
        # }}}

        my @input = split(",", $inputs);
        my $sqrp = $round;

        my $x = `$identify -format '\%w' $input[0]`;
        my $y = `$identify -format '\%h' $input[0]`;
        my $xmid = $x // 2;
        my $ymid = $y // 2;

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        mob::pretty($subname, "round borders");
        my @exe = (
            $runner,
            $input[0], "\(",
                "+clone", "-alpha", "extract",
                "-draw", "fill $color{background} polygon 0,0 0,15 15,0 fill $color{foreground} circle 16,15 15,0", "\(",
                    "+clone", "-flip",
                "\)",
                "-compose", "Multiply", "-composite", "\(",
                    "+clone", "-flop",
                "\)",
                "-compose", "Multiply", "-composite",
            "\)",
            "-alpha", "off", "-compose", "CopyOpacity", "-composite",
            $output,
        );

        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
