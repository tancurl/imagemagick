    # }}}

    # append {{{
    sub append {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs     = $opts->{input}        // '';
        my $output     = $opts->{output}       // '';
        my $background = $opts->{background}   // 'none';
        my $vertical   = $opts->{vertical}     // 1;
        my $horizontal = $opts->{horizontal}   // 0;
        my $position   = $opts->{position}     // "left";
        # }}}

        my @input = split(",", $inputs);

        my $append;
        if ($horizontal) {
            $append = "+append";
            $vertical = 0;
        }
        if ($vertical) {
            $append = "-append";
            $horizontal = 0;
        }

        # what would you want me to say here!?
        if ($vertical && $horizontal) {
            mob::log($subname, "What? vertical AND horizontal append?! make up your mind!\n", 2);
            mob::log($subname, "btw, How on earth did you manage to trigger this?! I ~~have~~ had a fail safe!\n", 3);
        }

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        mob::pretty($subname, "append images");
        my @exe = (
            $runner,
            $append,
            "-background", $background
        );
        if ($position) {
            my @positions = split /[, ]+/, $position;
            my $pos = "";
            my $h = "";
            foreach my $p (@positions) {
                if (($pos =~ /[lL]eft/ && $p =~ /[rR]ight/) || ($pos =~ /[rR]ight/ && $p =~ /[lL]left/)) {
                    $p = "center";
                }
                # $h = " " unless $pos ne "";
                $pos .= "${h}West" if $p =~ /[Ll]eft/;
                $pos .= "${h}East" if $p =~ /[Rr]ight/;
                $pos .= "${h}North" if $p =~ /[Tt]op/;
                $pos .= "${h}South" if $p =~ /[Bb]ottom/;
                $pos .= "${h}Center" if $p =~ /[Cc]enter/;
            }
            push @exe, ("-gravity", $pos);
        }
        foreach my $image (@input) {
            push(@exe, $image);
        }
        push(@exe, $output);

        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # blur {{{
    sub blur {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs = $opts->{input}        // '';
        my $output = $opts->{output}       // '';
        my $blur   = $opts->{blur}         // 2;
        my $rate   = $opts->{rate}         // 1;
        my $scale  = $opts->{scale}        // 2;
        my $geo    = $opts->{geo}          // 0;
        # }}}

        my @input = split(",", $inputs);

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        mob::pretty($subname, "blur image");
        my $format = "\%[fx:w+((w+h)/${scale}*0.1)]x\%[fx:h+((w+h)/${scale}*0.1)]";
        $geo = `$identify -format "$format" "@{input}"` unless $geo;

        my @exe = (
            $runner,
            "-resize", "$blur\%",
            $input[0],
            "-gaussian-blur", "1x${rate}",
            "-resize", "${geo}^",
            "-extent", "${geo}",
            $output,
        );

        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # pixel {{{
    sub pixel {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs     = $opts->{input}    // '';
        my $output     = $opts->{output}   // '';
        my $rate_down  = $opts->{rate}     // 20;
        # }}}

        my $rate_up = 10000 / $rate_down;

        my @input = split(",", $inputs);

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        mob::pretty($subname, "pixelate image");
        my @exe = (
            $runner,
            "@input",
            "-scale", sprintf("%s%%", ${rate_down}),
            "-scale", sprintf("%s%%", ${rate_up}),
            $output,
        );

        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # crop {{{
    sub crop {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs = $opts->{input}        // '';
        my $output = $opts->{output}       // '';
        my $round  = $opts->{round}        // 25;
        my $shape  = $opts->{shape}        // 'square';
        # }}}

        my @input = split(",", $inputs);
        my $sqrp = $round;

        my $x = `$identify -format '\%w' $input[0]`;
        my $y = `$identify -format '\%h' $input[0]`;
        my $xmid = $x // 2;
        my $ymid = $y // 2;

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        mob::pretty($subname, "crop image");
        my @exe;
        if ($shape eq "circle") {
            @exe = (
                $runner,
                $input[0],
                "\(",
                    "+clone",
                    "-size", "${x}x${y}",
                    "-threshold", "100\%",
                    "-fill", "white",
                    "-draw", "roundrectangle 0,0 ${x},${y} ${xmid},${ymid}",
                "\)",
                "-alpha", "off",
                "-compose", "CopyOpacity",
                "-composite",
                $output,
            );
        } else {
            @exe = (
                $runner,
                $input[0],
                "\(",
                    "+clone",
                    "-threshold", "100\%",
                    "-fill", "white",
                    "-draw", "roundrectangle 0,0 ${x},${y} ${sqrp},${sqrp}",
                "\)",
                "-alpha", "off",
                "-compose", "CopyOpacity",
                "-composite",
                $output,
            );
        }

        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # blend {{{
    sub blend {
