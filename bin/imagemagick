    # }}}

    # command {{{
    sub command {
        my $program = $_[0];
        my $path = $ENV{"PATH"};
        my @directories = split(":", $path);
        my $found = '';
        foreach my $dir (@directories) {
            my $full_path = "$dir/$program";
            if (-x $full_path) {
                $found = $full_path;
                last;
            }
        }
        return $found;
    }
    # }}}

    # clean {{{
    sub clean {
        # my $clean = "\b\b\b\b    ";
        # print(STREAM $clean);

        my $repeat = 1;
        my @spinner = ('|', '/', '-', '\\');
        my $duration = shift;  # Duration to display the spinner
        my $end_time = time() + $repeat;

        while (time() < $end_time) {
            for my $char (@spinner) {
                print STREAM "\r";
                print STREAM $char;
                sleep(0.06);
                print STREAM "\b ";
            }
        }
    }
    # }}}

    # exit code {{{
    sub check_exit_code {
        my ($package, $filename, $line) = caller();
        my $exit_code = $_[0];
        my $fail = 'fail';  # ×
        my $done = "done";  # ✓
        my $side = "fg";
        $fail = "$fail" if $side eq "fg";
        $done = "$done" if $side eq "fg";
        $fail = " $fail " if $side eq "bg";
        $done = " $done " if $side eq "bg";
        my %color = (
            bg => {
                fail => "on_red",
                done => "on_green",
            },
            fg => {
                fail => "red",
                done => "green",
            },
        );
        my $msg = "";
        if ($exit_code) {
            $msg = sprintf(" ... %s",
                colored($fail, $color{$side}{fail}));
            print("\n");
            exit $line;
        } else {
            $msg = sprintf(" ... %s",
                colored($done, $color{$side}{done}));
        }
        return $msg;
    }
    # }}}

    # log {{{
    sub log {
        my ($name, $msg, $level) = @_;
        $level //= 1;
        my ($package, $filename, $line) = caller();
        my $current_date = strftime("%Y-%m-%d %H:%M:%S", localtime);

        my $message;
        if ($name) {
            $message = sprintf "] %s %s %s::%-4s | %s",
                $current_date, $prompt, $name, $line, $msg;
        } else {
            $message = sprintf "] %s %s %-4s | %s",
                $current_date, $prompt, $line, $msg;
        }
        # my $message = "] $current_date ${prompt} ${package}::${name}   >>> ${line} | $msg";

        return if $level == 0;
        print($message) if $level == 1;
        print(STREAM "\r") if $level != 1;
        print(STREAM $message) if $level != 1;
        print(STREAM "\n") if $level gt 3;
        exit $line if $level ge 3;

    }
    # }}}

    # get terminal width {{{
    sub get_width {
        # -------------------------------------------------
        # Platform‑specific constant for the ioctl request
        #   Linux   : 0x5413
        #   macOS/BSD: 0x40087468
        # Choose the one that matches your OS.
        # -------------------------------------------------
        use constant TIOCGWINSZ => 0x5413;   # <-- change if you’re on macOS/BSD
        my $winsz = pack('S4', 0, 0, 0, 0);
        my @handles = (
            *STDOUT{IO},
            *STDIN{IO},
            do { open my $tty, '<', '/dev/tty' or die "Can't open /dev/tty: $!"; $tty },
        );
        my $got;
        for my $fh (@handles) {
            $got = ioctl($fh, TIOCGWINSZ, $winsz);
            last if $got;
        }
        die "ioctl failed – not a terminal?" unless $got;
        my ($rows, $cols, $xpixels, $ypixels) = unpack('S4', $winsz);
        return $cols;
    }
    # }}}

    # prettry {{{
    sub pretty {
        my ($name, $msg, $level) = @_;
        # $name =~ s,^im,,;
        $level //= 6;
        my ($package, $filename, $line) = caller();

        # my $current_length = $blank_height - length($name) + 1;
        # my $blank = " "x$current_length;

        my $logcolor;
        $logcolor = "black" if $level == 0;
        $logcolor = "red" if $level == 1;
        $logcolor = "green" if $level == 2;
        $logcolor = "yellow" if $level == 3;
        $logcolor = "blue" if $level == 4;
        $logcolor = "magenta" if $level == 5;
        $logcolor = "cyan" if $level == 6;
        $logcolor = "white" if $level == 7;

        my $message = "";

        # $message = "$prompt ".color("bold $logcolor")."${package}::$name".color('reset')." $msg";
        # $message = "$prompt ".color("bold $logcolor")."$name".color('reset').$blank.$msg;

        # $message = colored("$prompt ", "bold $logcolor");
        # $message = "$prompt ".color("bold $logcolor")."$name".color('reset').$blank;
        if ($name) {
            $message = sprintf("%s %s %s",
                colored($prompt, "blue"),
                colored($cmd,    "yellow"),
                colored($name,   "cyan")
            );
        } else {
            $message = sprintf("%s %s",
                colored($prompt, "blue"),
                colored($cmd,    "yellow")
            );
        }

        if ($msg) {
            $message .= " ... $msg";
        }

        # # left padding
        # my $width_term = mob::get_width();
        # my $width_text = length($message);
        # my $width_blank = $width_term - $width_text;
        # my $blank = " "x$width_blank;
        # $message .= $blank if $width_blank;

        print(STREAM "$message");

        # print(STREAM "\033[K");  # clear the line
        # print(STREAM "\r");
        # print(STREAM "\033[F");  # move up
        # print(STREAM "\033[2J");  # clear the screen
        # print(STREAM "\033[H");   # move cursor to the top left
    }
    # }}}

    # get the language {{{
    sub get_syntax {
        my $filename = $_[0];  # Replace with your file name
        my $shebang;
        open(my $fh, '<', $filename) or die "Could not open file '$filename' $!";
        my $first_line = <$fh>;
        $shebang = $first_line if $first_line =~ /^#!/;
        chomp($shebang) if $shebang;
        close($fh);
        my $language;
        if ($shebang) {
            $language = (split("/", $shebang))[-1];
            $language =~ s/env // if $language =~ /env /;
            # print(STREAM "$shebang\n");
        } else {
            $language = `$highlighter -N $filename`;
            chomp($language);
        }
        return $language;
    }
    # }}}

    # shell wrapper {{{
    sub shell {
        my (@cmd) = @_;
        my $stdin = undef; my $stdout; my $stderr = gensym;
        my $pid = open3(
            $stdin, $stdout, $stderr,
            @cmd,
        );
        waitpid($pid, 0);
        my $err = $? >> 8;
        return $err;
    }
    # }}}

}
