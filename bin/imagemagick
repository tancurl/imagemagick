# append {{{
sub imappend {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs     = $opts->{input}        // '';
    my $output     = $opts->{output}       // '';
    my $vertical   = $opts->{vertical}     // 1;
    my $horizontal = $opts->{horizontal}   // 0;
    # }}}

    my @input = split(",", $inputs);

    my $append;
    if ($horizontal) {
        $append = "+append";
        $vertical = 0;
    }
    if ($vertical) {
        $append = "-append";
        $horizontal = 0;
    }

    # what would you want me to say here!?
    if ($vertical && $horizontal) {
        logger($subname, "What? vertical AND horizontal append?! make up your mind!\n", 2);
        logger($subname, "btw, How on earth did you manage to trigger this?! I ~~have~~ had a fail safe!\n", 3);
    }

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "$input[0] > $output ");
    my @exe = (
        $runner,
        $append,
    );
    foreach my $image (@input) {
        push(@exe, $image);
    }
    push(@exe, $output);

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# blur {{{
sub imblur {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my $blur   = $opts->{blur}         // 3;
    my $rate   = $opts->{rate}         // 5;
    my $scale  = $opts->{scale}        // 3;
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "$input[0] > $output ");
    my $format = "\%[fx:w+((w+h)/${scale}*0.1)]x\%[fx:h+((w+h)/${scale}*0.1)]";
    my $geo = `$identify -format "$format" "@{input}"`;

    my @exe = (
        $runner,
        "-resize", "$blur\%",
        $input[0],
        "-gaussian-blur", "1x${rate}",
        "-resize", "${geo}^",
        "-extent", "${geo}",
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# crop {{{
sub imcrop {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my $round  = $opts->{round}        // 25;
    my $shape  = $opts->{shape}        // 'square';
    # }}}

    my @input = split(",", $inputs);
    my $sqrp = $round;

    my $x = `$identify -format '\%w' $input[0]`;
    my $y = `$identify -format '\%h' $input[0]`;
    my $xmid = $x // 2;
    my $ymid = $y // 2;

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "$input[0] > $output ");
    my @exe;
    if ($shape eq "circle") {
        @exe = (
            $runner,
            $input[0],
            "\(",
                "+clone",
                "-size", "${x}x${y}",
                "-threshold", "100\%",
                "-fill", "white",
                "-draw", "roundrectangle 0,0 ${x},${y} ${xmid},${ymid}",
            "\)",
            "-alpha", "off",
            "-compose", "CopyOpacity",
            "-composite",
            $output,
        );
    } else {
        @exe = (
            $runner,
            $input[0],
            "\(",
                "+clone",
                "-threshold", "100\%",
                "-fill", "white",
                "-draw", "roundrectangle 0,0 ${x},${y} ${sqrp},${sqrp}",
            "\)",
            "-alpha", "off",
            "-compose", "CopyOpacity",
            "-composite",
            $output,
        );
    }

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# color {{{
sub imcolor {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output  = $opts->{output}       // '';
    my $find    = $opts->{find}         // '';
    my $replace = $opts->{replace}      // '';
    my $percent = $opts->{percent}      // 55;
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;
    logger($subname, "No color is specified to find\n", 3) unless $find;
    logger($subname, "No color is specified to replace\n", 3) unless $replace;

    pretty("$subname", "$input[0] > $output ");
    my @exe = (
        $runner,
        $input[0],
        "-fuzz",   "$percent\%",
        "-fill",   "$find\%",
        "-opaque", "$replace\%",
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
