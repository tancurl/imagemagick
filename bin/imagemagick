# main {{{
if ($cmd eq "shadow") {
    job::shadow({
        input => join(",", @input),
        output => $output,
        shadow_color => $background,
        # shadow_color => join(",", @color),
        shadow_width => $width,
        shadow_rate  => $rate,
        border_width => $border,
    });
    exit 0;
}

if ($cmd eq "round") {
    job::round({
        input => join(",", @input),
        output => $output,
        round => $round,
        color_background => $background,
        color_foreground => $foreground,
    });
    exit 0;
}

if ($cmd eq "src") {
    job::src({
        input => join(",", @input),
        output => $output,
        language => $language,
        frame_title => "@text",
        linenumber => $linenumber,
        alpha_apply => $alpha,
        alpha_width => 20,
        shadow_apply => $shadow,
        shadow_double => 0,
        gradient_apply => $gradient,
        gradient_mirror => 0,
        gradient_rotate => $gradient_rotation,
        gradient_orientation => $orientation,
        color_gradient_first => $gradient_color[0],
        color_gradient_second => $gradient_color[1],
    });
    exit 0;
}

if ($cmd eq "palette") {
    my @palette = job::palette({
        input => @input,
        type => $palette,
    });
    print(STREAM "\n\n");
    foreach my $color (@palette) {
        print(STREAM "  $color\n");
    }
    exit 0;
}


if ($cmd eq "append") {
    job::append({
        input => join(",", @input),
        output => $output,
        background => $background,
        horizontal => $horizontal,
        vertical => $vertical,
        position => $position,
    });
    exit 0;
}

