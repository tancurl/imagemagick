# workers {{{

# solid {{{
sub imsolid {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $width       = $opts->{width}      // '800';
    my $height      = $opts->{height}     // '800';
    my $background  = $opts->{background} // 'black';
    my $output      = $opts->{output}     // '';
    # }}}

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "missing file: output: $output: No such file or directory\n", 3) unless -f $output;
    logger($subname, "No color image is specified, using default\n", 2) unless $background;

    pretty("$subname", "${width}x${height}: $background > $output ");
    my @exe = (
        $runner,
        "-size", "${width}x${height}",
        "xc:$background",
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# resize {{{
sub imresize {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my %resolution = (
        a => $opts->{resolution_a}     // '',
        x => $opts->{resolution_x}     // '',
        y => $opts->{resolution_y}     // '',
    );
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;
    logger($subname, "No resolution is specified\n", 3) unless $resolution{a};
    unless ($resolution{x}) {
        $resolution{x} =~ s/x.*//;
        logger($subname, "No x resolution\n", 2)
    }
    unless ($resolution{y}) {
        $resolution{y} =~ s/.*x//;
        logger($subname, "No y resolution\n", 2);
    }

    pretty("$subname", "$input[0] > $output ");
    my @exe = (
        $runner,
            "-resize", "$resolution{a}^",
            $input[0],
            "-background", "none",
            "-gravity", "center",
            "-extent", "$resolution{a}^",
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));

}
# }}}

# shadow {{{
sub imshadow {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my %border = (
        color => $opts->{border_color} // "none",
        width => $opts->{border_width} // 0,
    );
    my %shadow = (
        width => $opts->{shadow_width} // 110,
        color => $opts->{shadow_color} // "black",
        rate  => $opts->{shadow_rate}  // 10,
        x     => $opts->{shadow_x}     // 1,
        y     => $opts->{shadow_y}     // 1,
    );
    my $background_color = $opts->{background_color} // 'none';
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    pretty("$subname", "$input[0] > $output ");
    my @exe = (
        $runner,
        $input[0],
        "-bordercolor", $border{color},
        "-border", $border{width}, '(',
            "+clone", "-background",
            $shadow{color}, "-shadow", "$shadow{width}x$shadow{rate}+$shadow{x}+$shadow{y}",
        ')',
        "+swap", "-background", ${background_color},
        "-layers", "merge", "+repage",
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# alpha {{{
sub imalpha {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}    // '';
    my $output = $opts->{output}   // '';
    my $color  = $opts->{color}    // 'white';
    my $fuzz   = $opts->{fuzz}     // 99;
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "No input image is specified\n", 3) unless $input[0];
