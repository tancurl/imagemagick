# }}}

if ($help || !$cmd || $cmd eq "help") {
    print_usage();
}

print(STREAM "] $date $prompt $cmd\n");

if ($cmd eq "list") {
    print(STREAM "] List of valid commands:\n");
    foreach my $ss (@subs) {
        print(STREAM "    $ss\n");
    }
}

# main {{{
if ($cmd eq "shadow") {
    imshadow({
        input => join(",", @input),
        output => $output,
    })
}

if ($cmd eq "src") {
    imsrc({
        input => join(",", @input),
        output => $output,
        language => $language,
        linenumber => $linenumber,
        alpha_apply => $alpha,
        alpha_width => 20,
        shadow_apply => $shadow,
        shadow_double => 0,
        gradient_apply => $gradient,
        gradient_mirror => 0,
        gradient_rotate => $gradient_rotation,
        gradient_orientation => $orientation,
        color_gradient_first => $gradient_color[0],
        color_gradient_second => $gradient_color[1],
    });
}

if ($cmd eq "palette") {
    my @palette = impalette({
        input => @input,
        type => $palette,
    });
    print(STREAM "\n\n");
    foreach my $color (@palette) {
        print(STREAM "  $color\n");
    }
}


if ($cmd eq "append") {
    imappend({
        input => join(",", @input),
        output => $output,
        horizontal => $horizontal,
        vertical => $vertical,
    });
}

if ($cmd eq "merge") {
    immerge({
        input => join(",", @input),
        output => $output,
    });
}

if ($cmd eq "trim") {
    imtrim({
        input => join(",", @input),
        output => $output,
    });
}

if ($cmd eq "string") {
    @input = ('null') unless @input;
    imstring({
        input => @input,
        output => $output,
        text => $text,
        color_background => $background,
        color_foreground => $foreground,
        size => $size,
    });
}

if ($cmd eq "extend") {
    imextend({
        input => @input,
        output => $output,
        rate => $rate,
        color_background => $background,
        x => $width,
        y => $height,
        gradient => $gradient,
    });
}

if ($cmd eq "crop") {
    imcrop({
        input => join(",", @input),
        output => $output,
        shape => $shape,
    });
}

if ($cmd eq "solid") {
    imsolid({
        width => $width,
        height => $height,
        background => $background,
        output => $output,
    });
}

# }}}

print("\n");

