    job::extend({
        input => join(",", @input),
        output => $output,
        color_background => $background,
        gradient => $gradient,
        rate => $rate,
        color_background => $background,
        x => $width,
        y => $height,
        gradient => $gradient,
    });
    exit 0;
}

if ($cmd eq "crop") {
    job::crop({
        input => join(",", @input),
        output => $output,
        shape => $shape,
    });
    exit 0;
}

if ($cmd eq "solid") {
    job::solid({
        width => $width,
        height => $height,
        background => $background,
        output => $output,
    });
    exit 0;
}

if ($cmd eq "blend") {
    job::blend({
        input  => join(",", @input),
        output => $output,
        color  => $color[0],
        rate   => $rate,
        # scale => $scale,
    });
    exit 0;
}

if ($cmd eq "blur") {
    job::blur({
        input => join(",", @input),
        output => $output,
        # geo => sprintf("%sx%s", $width, $height),
        # rate => $rate,
        # blur => $blur,
        # scale => $scale,
    });
    exit 0;
}

if ($cmd eq "pixel") {
    job::pixel({
        input => join(",", @input),
        output => $output,
        rate => $rate,
    });
    exit 0;
}

if ($cmd eq "box") {
    job::box({
        input  => join(",", @input),
        output => $output,
        color  => join(",", @color),
        expand => $expand,
        # color_first => $gradient_color[0],
        # color_second => $gradient_color[1],
        # gradient_width => "",
        # gradient_height => "",
        mirror => $mirror,
        rotate => $rotation,
        # orientation => $orientation,
    });
    exit 0;
}

if ($cmd eq "gradient") {
    job::gradient({
        input => join(",", @input),
        output => $output,
        color_first => $gradient_color[0],
        color_second => $gradient_color[1],
        gradient_width => "",
        gradient_height => "",
        mirror => $gradient_mirror,
        rotate => $gradient_rotation,
        orientation => $orientation,
    });
    exit 0;
}

