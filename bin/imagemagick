# gradient {{{
sub imgradient {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    my $mirror = $opts->{mirror}       // 0;
    my $rotate = $opts->{rotate}       // 0;
    my $orientation = $opts->{orientation} // 'vertical';
    my %color = (
        first       => $opts->{color_first}       // '#770000',
        second      => $opts->{color_second}      // '#ff7700',
        background  => $opts->{color_background}  // 'none',
    );
    my %shadow = (
        apply  => $opts->{shadow_apply}  // 1,
        double => $opts->{shadow_double} // 0,
        color  => $opts->{shadow_color}  // 'black',
        width  => $opts->{shadow_width}  // 110,
        rate   => $opts->{shadow_rate}   // 10,
    );
    my %border = (
        color  => $opts->{border_color}  // 'none',
        width  => $opts->{border_width}  // 0,
        rate   => $opts->{border_rate}   // 290,
    );
    my %position = (
        x  => $opts->{position_x}  // 1,
        y  => $opts->{position_y}  // 1,
    );
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    my $tmpdir = "/tmp/imagemagick/$timestamp-$subname";
    my $tmpfile = "$tmpdir/imagemagick-tmp-gradient.png";
    make_path($tmpdir);

    my $resolution   = `$identify -format '%wx%h' $input[0]`;
    my $resolution_x = `$identify -format '%w' $input[0]` + $border{rate};
    my $resolution_y = `$identify -format '%h' $input[0]` + $border{rate};

    ($color{first}, $color{second}) = ($color{second}, $color{first}) if $mirror;

    my $rotation = $rotate;

    my $gradient_orientation;
    $gradient_orientation = "gradient:$color{first}-$color{second}" if $orientation eq "vertical";
    $gradient_orientation = "gradient:$color{first}|$color{second}" if $orientation eq "horizontal";
    $gradient_orientation = "radial-gradient:$color{first}-$color{second}" if $orientation eq "radial";
    $gradient_orientation = "plasma:$color{first}-$color{second}" if $orientation eq "plasma";

    my $diag = int( sqrt($resolution_x**2 + $resolution_y**2) + 0.5 );

    pretty("$subname", "$input[0] > $output ");

    $gradient_orientation = "gradient:$color{first}-$color{second}";

    # # tile {{{
    # my @exe = (
    #     $runner,
    #     "xc:",
    #     '-size', "${resolution_x}x${resolution_y}",
    #     $gradient_orientation,
    #     '-virtual-pixel', 'tile',
    #     '-distort', 'SRT', $rotation,
    #     '-bordercolor', $border{color},
    #     '-border', $border{width},
    #     '+swap',
    #     '-background', $color{background},
    #     '-layers', 'merge',
    #     '+repage',
    #     $tmpfile,
    # );
    # # }}}

    my @exe = (
        $runner,
        "-size", "${resolution_x}x${resolution_y}",
        "gradient:$color{first}-$color{second}",
        "-distort", "SRT", $rotation,
        "xc:",
        "-bordercolor", $border{color},
        "-border", $border{width},
        "+swap",
        "-background", $color{background},
        "-layers", "merge",
        "+repage",
        $tmpfile,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));

    if ($shadow{apply}) {
        imshadow({
            input => $input[0],
            output => $output,
            shadow_rate => 5,
            shadow_width => 20,
            background_color => 'none'
        });
        clean();
        if ($shadow{double}) {
            imshadow({
                input => $output,
                output => $output,
                shadow_rate => 5,
                shadow_width => 20,
                background_color => 'none'
            });
            clean();
        }
    }
    immerge({input => "${output},$tmpfile", output => $output});
    clean();

    pretty($subname, "remove $tmpdir ");
    remove_tree($tmpdir, {error => \my $err});
    if (@$err) {
        foreach my $diag (@$err) {
            print(STREAM check_exit_code($?));
            logger($subname, "Failed to remove $diag->[0]: $diag->[1]\n", 2);
        }
    } else {
        # pretty("$subname", "remove $tmpdir");
        print(STREAM check_exit_code($?));
    }

}
# }}}

