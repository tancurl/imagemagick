sub imshot {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs = $opts->{input}        // '';
    my $output = $opts->{output}       // '';
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    my $shot_directory = "${home}/pictures/screenshots";
    mkdir($shot_directory) unless -d $shot_directory;

    pretty("$subname", " $output ");
    my @exe = (
        $runner,
        "-trim",
        $input[0],
        $output,
    );

    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));
}
# }}}

# title {{{
sub imtitle {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs   = $opts->{input}    // '';
    my $output   = $opts->{output}   // '';
	my $window   = $opts->{window}   // 1;;
	my $title    = $opts->{title}    // 'Source Code';;
    my $font     = $opts->{font}     // 'Ubuntu-Medium';;
    my $vertical = $opts->{vertical} // '-0';;
    my $size     = $opts->{size}     // 18;;
    my %color = (
        background => $opts->{color_background} // '#232323',
        foreground => $opts->{color_foreground} // '#d3d3d3',
        temperory  => $opts->{color_temperory}  // '#333339',
        button => {
            close => $opts->{color_button_close} // '#9999A0',
            maxim => $opts->{color_button_maxim} // '#9999A0',
            minim => $opts->{color_button_minim} // '#9999A0',
        },
    );
    my %border = (
        rate => 20,
    );
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless defined $input[0];
    logger($subname, "No output image is specified\n", 3) unless defined $output;

    my $tmpdir = "/tmp/imagemagick";
    my $tmpfile_title_bar = "$tmpdir/imagemagick-tmp-title-bar.png";
    my $tmpfile_title_button = "$tmpdir/imagemagick-tmp-title-button.png";
    mkdir($tmpdir);

    my %resolution = (
        a => `$identify -format '%wx%h' $input[0]`,
        x => `$identify -format '%w' $input[0]` + $border{rate},
        y => `$identify -format '%h' $input[0]` + $border{rate},
    );
    my %resolution_out = (
        x => $resolution{x} + $border{rate},
        y => $resolution{y} + $border{rate},
    );

    my $width = $resolution{x};
    my $height = $border{rate} + $border{rate};

    my $_tmpfile_title_button = (split("/", $tmpfile_title_button))[-1];
    my $_tmpfile_title_bar    = (split("/", $tmpfile_title_bar))[-1];

    logger($subname, "missing file: $tmpfile_title_button\n", 2) unless -f $tmpfile_title_button;
    logger($subname, "missing file: $tmpfile_title_bar\n", 2) unless -f $tmpfile_title_bar;

    pretty($subname, "$input[0] > $_tmpfile_title_bar ");
    my @exe = (
        $runner,
        "-size", "${width}x$height",
        "gradient:$color{temperory}-$color{background}",
        "-font", $font,
        "-pointsize", $size,
        "-fill", $color{foreground},
        "-gravity", "center",
        "-annotate", "+000$vertical", $title,
        $tmpfile_title_bar,
    );
    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));

    pretty($subname, "$_tmpfile_title_bar > $_tmpfile_title_button ");
    @exe = (
        $runner,
            $tmpfile_title_bar,
            "-fill", $color{button}{close}, "-draw", "circle 20,19 27,19",
            "-fill", $color{button}{minim}, "-draw", "circle 44,19 51,19",
            "-fill", $color{button}{maxim}, "-draw", "circle 68,19 75,19",
            $tmpfile_title_button,
    );
    $_exit_code = system(@exe);
    $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));

    pretty($subname, "$_tmpfile_title_button - $input[0] > $output ");
    @exe = (
        $runner,
            "-append",
            $tmpfile_title_button,
            $input[0],
            $output,
    );
    $_exit_code = system(@exe);
    $exit_code = $_exit_code >> 8;
    print(STREAM check_exit_code($exit_code));

    # imappend({input => "$tmpfile_title_button, $input[0]", output => $output});

    pretty($subname, "remove $tmpdir ");
    remove_tree($tmpdir, {error => \my $err});
    if (@$err) {
        foreach my $diag (@$err) {
            print(STREAM check_exit_code($?));
            logger($subname, "Failed to remove $diag->[0]: $diag->[1]\n", 2);
        }
    } else {
        # pretty("$subname", "remove $tmpdir");
        print(STREAM check_exit_code($?));
    }

    pretty("$subname", "$input[0] > $output ");
    print(STREAM check_exit_code($exit_code));
}
# }}}

# src {{{
sub imsrc {
    my $subname = (split(":", (caller(0))[3]))[-1];

    # params {{{
    my ($opts) = @_; # hashref
    $opts ||= {};
    my $inputs   = $opts->{input}    // '';
    my $output   = $opts->{output}   // '';
    my $language = $opts->{language} // '';
    my $theme    = $opts->{theme}    // 'gruvbox-dark';
    my %font = (
        name => $opts->{font_name} // 'Monospace',
        size => $opts->{font_size} // '22',
    );
    my %frame = (
        title => $opts->{frame_title} // 'Source Code',
    );
    my $round  = $opts->{round}  // 5;
    my %shadow = (
        apply  => $opts->{shadow_apply}  // '',
        color  => $opts->{shadow_color}  // 'black',
        width  => $opts->{shadow_width}  // 110,
        rate   => $opts->{shadow_rate}   // 10,
    );
    my %color = (
        border     => $opts->{color_border}     // '#0f0f0f',
        background => $opts->{color_background} // '#151515',
        foreground => $opts->{color_foreground} // '#ccccce',
        frame      => $opts->{color_frame}      // '#0f0f0f',
        gradiant   => {
            first  => $opts->{color_gradiant_first}  // '#b9f27c',
            second => $opts->{color_gradiant_second} // '#ff9e64',
        },
    );
    my %border = (
        width       => $opts->{border_width}     // 25,
    );
    my %gradiant = (
        apply  => $opts->{gradiant_apply}  // 1,
        mirror => $opts->{gradiant_mirror} // 0,
        width  => $opts->{gradiant_width}  // 100,
        height => $opts->{gradiant_height} // 160,
    );
    # }}}

    my @input = split(",", $inputs);

    my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

    logger($subname, "input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
    logger($subname, "No input image is specified\n", 3) unless $input[0];
    logger($subname, "No output image is specified\n", 3) unless $output;

    my $tmpdir = "/tmp/imagemagick-$timestamp";
    my $tmpfile_nl = "$tmpdir/imagemagick-tmp-nl.txt";
    my $tmpfile_pango = "$tmpdir/imagemagick-tmp-pango.xml";
    my $tmpfile_image = "$tmpdir/imagemagick-tmp-image.png";
    mkdir($tmpdir);

    # my @job_add_line_number = (
    #     "nl", "-b", "a", $input[0]
    # );
    # open my $output_fh, '>', $tmpfile_nl or die "Could not open '$tmpfile_nl': $!";
    # # Execute the command and redirect output to the file handle
    # open my $nl_fh, '-|', @job_add_line_number or die "Could not execute nl: $!";
    # while (my $line = <$nl_fh>) {
    #     print $output_fh $line;  # Write to the output file
    # }
    # close $nl_fh;
    # close $output_fh;

    pretty("$subname", "$input[0] > $tmpfile_pango ");
    my @exe = (
        $highligher,
            $input[0],
            "-O", "style=$theme",
            "-O", "bgcolor=base03",
            "-f", "pango",
            "-o", $tmpfile_pango
    );
    push(@exe, ("-l", $language)) if $language;
    my $_exit_code = system(@exe);
    my $exit_code = $_exit_code >> 8;
    check_exit_code($exit_code);

    pretty("$subname", "$tmpfile_pango > $tmpfile_image ");
    @exe = (
        $runner,
        "-background", $color{background},
        "-pointsize", $font{size},
        "pango:\@$tmpfile_pango",
        $tmpfile_image,
    );
    $_exit_code = system(@exe);
    $exit_code = $_exit_code >> 8;
    check_exit_code($exit_code);

    imtrim({input => $output, output => $output});
    imshadow({input => $tmpfile_image, output => $output, shadow_width => $shadow{width}, shadow_color => 'none', border_width => $border{width}, border_color => $color{border}});
    imtitle({input => $output, output => $output, frame_title => $frame{title}, background_color => $color{background}});
    imround({input => $output, output => $output, round => $round});
    imshadow({input => $tmpfile_image, output => $output, shadow_width => $shadow{width}, shadow_color => 'none', border_width => 1, border_color => $color{border}});
    imtrim({input => $output, output => $output});
    imround({input => $output, output => $output, round => $round});
    # imgradiant({input => $output, output => $output});

    pretty($subname, "remove $tmpdir ");
    remove_tree($tmpdir, {error => \my $err});
    if (@$err) {
        foreach my $diag (@$err) {
            print(STREAM check_exit_code($?));
            logger($subname, "Failed to remove $diag->[0]: $diag->[1]\n", 2);
        }
    } else {
        # pretty("$subname", "remove $tmpdir");
        print(STREAM check_exit_code($?));
    }

    pretty("$subname", "$tmpfile_pango > $output ");
    print(STREAM check_exit_code($exit_code));
}
# }}}

