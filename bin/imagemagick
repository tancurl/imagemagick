# workers {{{
{
    package job;

    use POSIX qw(strftime);
    use File::Path qw(remove_tree make_path);

    *STREAM = *STDERR if $std_stream == 2;
    *STREAM = *STDOUT if $std_stream == 1;

    # solid {{{
    sub solid {
        my $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $width       = $opts->{width}      // '800';
        my $height      = $opts->{height}     // '800';
        my $background  = $opts->{background} // 'black';
        my $output      = $opts->{output}     // '';
        # }}}

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        # mob::log($subname, "missing file: output: $output: No such file or directory\n", 3) unless -f $output;
        mob::log($subname, "output: $output: file exists. overwritting..\n", 2) if -f $output;
        mob::log($subname, "No color image is specified, using default\n", 2) unless $background;

        mob::pretty($subname, "create solid color image");
        my @exe = (
            $runner,
            "-channel", "RGBA",
            "-size", "${width}x${height}",
            "xc:$background",
            $output,
        );

        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # resize {{{
    sub resize {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs = $opts->{input}        // '';
        my $output = $opts->{output}       // '';
        my %resolution = (
            a => $opts->{resolution_a}     // '',
            x => $opts->{resolution_x}     // '',
            y => $opts->{resolution_y}     // '',
        );
        # }}}

        my @input = split(",", $inputs);

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;
        mob::log($subname, "No resolution is specified\n", 3) unless $resolution{a};
        unless ($resolution{x}) {
            $resolution{x} =~ s/x.*//;
            mob::log($subname, "No x resolution\n", 2)
        }
        unless ($resolution{y}) {
            $resolution{y} =~ s/.*x//;
            mob::log($subname, "No y resolution\n", 2);
        }

        mob::pretty($subname, "resize image");
        my @exe = (
            $runner,
                "-resize", "$resolution{a}^",
                $input[0],
                "-background", "none",
                "-gravity", "center",
                "-extent", "$resolution{a}^",
            $output,
        );

        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";

    }
    # }}}

    # shadow {{{
    sub shadow {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs = $opts->{input}        // '';
        my $output = $opts->{output}       // '';
        my %border = (
            color => $opts->{border_color} // "none",
            width => $opts->{border_width} // 0,
        );
        my %shadow = (
            width => $opts->{shadow_width} // 110,
            color => $opts->{shadow_color} // "black",
            rate  => $opts->{shadow_rate}  // 10,
            x     => $opts->{shadow_x}     // 1,
            y     => $opts->{shadow_y}     // 1,
        );
        my $background_color = $opts->{background_color} // 'none';
        # }}}

        my @input = split(",", $inputs);

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        mob::pretty($subname, "add shadow border");
        my @exe = (
            $runner,
            $input[0],
            "-bordercolor", $border{color},
            "-border", $border{width}, '(',
                "+clone", "-background",
                $shadow{color}, "-shadow", "$shadow{width}x$shadow{rate}+$shadow{x}+$shadow{y}",
            ')',
            "+swap", "-background", ${background_color},
            "-layers", "merge", "+repage",
            $output,
        );

        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # alpha {{{
    sub alpha {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
        my $inputs = $opts->{input}    // '';
        my $output = $opts->{output}   // '';
        my $color  = $opts->{color}    // 'white';
        my $fuzz   = $opts->{fuzz}     // 99;
        # }}}

        my @input = split(",", $inputs);

        my $timestamp = strftime("%Y-%m-%d-%H-%M-%S", localtime);

        mob::log($subname, "No input image is specified\n", 3) unless $input[0];
        mob::log($subname, "missing file: input: $input[0]: No such file or directory\n", 3) unless -f $input[0];
        mob::log($subname, "No output image is specified\n", 3) unless $output;

        mob::pretty($subname, "make color transparent");
        my @exe = (
            $runner,
            "-transparent", $color,
            "-fuzz", "$fuzz\%",
            $input[0],
            $output,
        );

        my $_exit_code = mob::shell(@exe);
        my $exit_code = $_exit_code >> 8;
        print(STREAM mob::check_exit_code($exit_code));
        print "\n";
    }
    # }}}

    # trim {{{
    sub trim {
        my $subname = (split(":", (caller(0))[3]))[-1];
        $subname = (caller(0))[3];

        # params {{{
        my ($opts) = @_; # hashref
        $opts ||= {};
